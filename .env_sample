# =============================================================================
# SparkMe web study (.env). Copy to .env and fill in. See README.md > Configuration.
# =============================================================================

# --- Flask ---------------------------------------------------------------------
# Set a fixed value. If unset, a random key is generated per start (logs everyone out).
FLASK_SECRET_KEY=<long_random_string>

# --- Storage ---------------------------------------------------------------------
# Production uses data/data and data/logs.
DATA_DIR="data/data"
LOGS_DIR="data/logs"

# --- Candidate models (the Interviewer) --------------------------------------------
# Every turn shows MODEL_NAME_1 + MODEL_NAME_2 + 2 random picks from MODEL_NAME_3..6.
# The rotating pool stops at the first unset slot. Prefixes: openrouter:, fanar:,
# jais:, gemini-api:, vllm:, openai-next: (see src/utils/llm/engines.py).
MODEL_NAME_1="openrouter:<vendor>/<model>"
MODEL_NAME_2="fanar:<model>"
MODEL_NAME_3="openrouter:<vendor>/<model>"
MODEL_NAME_4="openrouter:<vendor>/<model>"
# MODEL_NAME_5=
# MODEL_NAME_6=

# Provider credentials (only the ones your MODEL_NAME_* use)
OPENROUTER_API_KEY=<your_openrouter_api_key>
# FANAR_API_KEY=<your_fanar_api_key>
# GEMINI_API_KEY=<your_gemini_api_key>
# JAIS2_API_KEY=<your_jais_api_key>
# OPENAI_NEXT_API_KEY=<your_openai_next_api_key>

# LLM call limits (defaults shown)
ENGINE_TIMEOUT_SECONDS=20
ENGINE_MAX_ATTEMPTS=3
ENGINE_MAX_WORKERS=16
INTERVIEWER_MAX_TOKENS=3000

# Number of past turns included in the prompt
MAX_EVENTS_LEN=10

# Minutes without a message before a live session stops (it resumes from the CSV on reopen)
SESSION_TIMEOUT_MINUTES=10

# --- Required by dormant upstream agents -------------------------------------------
# Every agent builds a default engine from MODEL_NAME at startup, even though
# it's never called in the web study. The model and its key must be valid.
MODEL_NAME="gpt-4.1-mini"
OPENAI_API_KEY=<your_openai_api_key>
# Nothing in the web flow reads embeddings; "noop" avoids needing a key for them.
EMBEDDING_BACKEND=openai

# =============================================================================
# Upstream SparkMe settings (terminal mode, baselines, evaluation). Not used by the web study.
# =============================================================================
# # Together.ai
# TOGETHER_API_KEY=<your_together_api_key>
# # Google Cloud Platform (Vertex AI Claude/Gemini)
# GCP_PROJECT=<your_gcp_project>
# GCP_REGION=<your_gcp_region>
# GCP_CREDENTIALS=<your_gcp_credentials_path>

SESSION_SCRIBE_MODEL_NAME="gpt-4.1-mini"
STRATEGIC_PLANNER_MODEL_NAME="gpt-4.1-mini"
MAX_CONSIDERATION_ITERATIONS=4
USE_BASELINE_PROMPT="false"

# Strategic Planner (disabled in InterviewSession)
STRATEGIC_PLANNER_TURN_TRIGGER_MIN=2
STRATEGIC_PLANNER_NUM_ROLLOUTS=3
STRATEGIC_PLANNER_ROLLOUT_HORIZON=2
STRATEGIC_PLANNER_MAX_QUESTIONS=5
STRATEGIC_PLANNER_ALPHA=1
STRATEGIC_PLANNER_BETA=1
STRATEGIC_PLANNER_GAMMA=1
STRATEGIC_PLANNER_MIN_NOVELTY=0.6

# Evaluation
EVAL_MODE="false"
COMPLETION_METRIC="minimum_threshold"

# WorkBank interview configs and personas
USER_AGENT_PROFILES_DIR="data/sample_user_profiles"
INTERVIEW_PLAN_PATH="data/configs/topics.json"
USER_PORTRAIT_PATH="data/configs/user_portrait.json"
MEMORY_THRESHOLD_FOR_UPDATE=10

# # AWS S3 (optional, for auto interviewer voice transcription)
# AWS_ACCESS_KEY_ID=<your_access_key_id>
# AWS_SECRET_ACCESS_KEY=<your_secret_access_key>
# AWS_BUCKET_NAME=<your_bucket_name>
